    "test:sandplay": "node --test tests/sandplay-bridge.test.mjs",
    "test:islands": "bun test tests/island-world.test.mjs",
    "test:mandala": "bun test tests/mandala.test.mjs",
    "test:mindfulness": "bun test tests/mindfulness.test.mjs"
  },
