# Copy to .env.local in this directory. Never put these values in frontend/.
# mock: explicitly simulated replies, no paid API requests.
# live: requires all three provider settings below. Restart the proxy after edits.
AI_MODE=mock
AI_API_KEY=
# Your provider's API base, normally ending in /v1. /chat/completions is appended.
AI_BASE_URL=
AI_MODEL=
# auto: SSE, or JSON / one non-streaming retry ONLY for explicit stream rejection.
# off: request non-streaming directly. on: stream request without automatic retry.
AI_STREAM_MODE=auto
# Choose the parameter supported by your provider.
AI_TOKEN_PARAMETER=max_tokens
AI_MAX_OUTPUT_TOKENS=512
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_CONCURRENT=2
# Optional server-only override. Default: demo_ai/data/mind_island_demo.sqlite3
# DEMO_DATABASE_PATH=
# Memory is OFF until authorized in the UI. These values do not grant consent.
# Empty MEMORY_MODEL reuses AI_MODEL; same server-side key and API base.
MEMORY_MODEL=
MEMORY_MAX_OUTPUT_TOKENS=768
MEMORY_TIMEOUT_SECONDS=20
MEMORY_DAILY_CALL_LIMIT=20
# Failed calls never auto-retry; this limit includes an explicit user retry.
MEMORY_MAX_ATTEMPTS=2
